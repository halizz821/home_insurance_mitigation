# ==============================================================================
# Environment Configuration Template for Home Insurance Mitigation System
# Copy this file to '.env' and populate your API credentials.
# ==============================================================================

# [Required] Google Gemini API Key
# Powers the Property Loss-Mitigation Specialist ReAct agent and Safety Guardrail auditor
GOOGLE_API_KEY=your_gemini_api_key_here

# [Required for Evaluation] OpenAI API Key
# Powers the 3-Prompt LLM-as-a-Judge benchmark suite (evaluate_pipeline.py)
OPENAI_API_KEY=your_openai_api_key_here

# [Optional] LangSmith Observability & Agent Tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=home_policy_weather
